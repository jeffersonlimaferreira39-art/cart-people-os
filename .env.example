# Supabase (Project Settings → API). A chave publicável pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta (service role). SOMENTE servidor: convites de usuário e nomes na auditoria.
# Nunca use prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SECRET_KEY=sb_secret_...

# URL pública do sistema (links de convite e de acesso por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assistente de IA (opcional). Sem a chave, a tela do assistente mostra um aviso.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
